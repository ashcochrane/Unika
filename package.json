{
  "name": "unika-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "dev": "shopify theme dev",
    "pull": "shopify theme pull",
    "push:dev": "shopify theme push -e development",
    "check": "shopify theme check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run check && npm run format:check",
    "preview": "./scripts/preview.sh"
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "^1.11.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{js,css,liquid,json}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
