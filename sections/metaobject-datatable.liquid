{% comment %}
  paginate by 300 exceeds the documented Shopify maximum of 250, but is load-bearing:
  there are 299 laminate entries and all of them must reach the page, because
  DataTables searches client-side over whatever was rendered. Dropping to 250 hides 49.

  WARNING: at 299/300 this is one entry away from silently truncating. Before adding
  more laminates, this section needs reworking — see CLAUDE.md.
{% endcomment %}
{% # theme-check-disable PaginationSize %}
{% paginate shop.metaobjects.laminates.values by 300 %}
  {% assign metaobjects = shop.metaobjects.laminates.values %}
  {% assign count = shop.metaobjects.laminates.values_count %}

  {%- style -%}
    .colour-matcher-wrapper {
      display: flex;
    }
    .colour-matcher-tick {
      text-align: center;
      vertical-align: middle;
    }
    .color-box {
      width: 40px;
      height: 40px;
      border-radius: 4px;
    }
    @media (max-width: 768px) {
      .hide-on-mobile {
        display: none;
      }
    }
  {%- endstyle -%}

  <!-- DataTables CSS -->
  {{ 'datatables.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'datatables.js' | asset_url }}" defer="defer"></script>
  {{ 'colour-matcher-cart.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'colour-matcher-cart.js' | asset_url }}" defer="defer"></script>
  <script id="ColourMatcherVariants" type="application/json">
    {%- render 'variant-code-map', product_handles: section.settings.orderable_handles -%}
  </script>

  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="colour-matcher-wrapper page-width section-{{ section.id }}-padding">
      {% if metaobjects and count > 0 %}
        <table id="colour-matcher-table" class="display">
          <thead>
            <tr>
              <th>Manufacturer</th>
              {% comment %}
                <th class="hide-on-mobile">Finish</th>
                <th class="hide-on-mobile">Code</th>
              {% endcomment %}
              <th>Sheet Name</th>
              <th>ColorFill Code</th>
              <th class="colour-matcher-order-col">Order</th>
              <th class="hide-on-mobile">ColorFill Colour</th>
              <th>In Stock</th>
              <th>TopSeal Code</th>
              <th class="hide-on-mobile">TopSeal Colour</th>
              <th>In Stock</th>
            </tr>
          </thead>
          <tbody>
            {% for metaobject in metaobjects %}
              <tr>
                <td>
                  {{ metaobject.range.value }}
                </td>
                {% comment %}
                  <td class="hide-on-mobile">
                    {{ metaobject.finish.value }}
                  </td>
                  <td class="hide-on-mobile">
                    {{ metaobject.code.value }}
                  </td>
                {% endcomment %}
                <td>
                  {{ metaobject.name.value }}
                </td>
                {% if metaobject.reference %}
                  {% assign referenced_metaobject = metaobject.reference.value %}
                  <td>{{ referenced_metaobject.colorfill_code }}</td>
                  <td class="colour-matcher-order-col">
                    {%- assign cf_code = referenced_metaobject.colorfill_code | strip | upcase -%}
                    {%- if cf_code != blank -%}
                      <button
                        type="button"
                        class="colour-matcher-add"
                        data-code="{{ cf_code | escape }}"
                        aria-label="Add ColorFill {{ cf_code | escape }} to cart"
                      >
                        Add
                      </button>
                    {%- endif -%}
                  </td>
                  <td
                    class="hide-on-mobile"
                    style="background-color: {{ referenced_metaobject.colorfill_hex | strip }}"
                  />
                  {% if referenced_metaobject.colorfill_in_stock %}
                    <td class="colour-matcher-tick">&#10004;</td>
                  {% else %}
                    <td />
                  {% endif %}
                  <td>{{ referenced_metaobject.topseal_code }}</td>
                  <td
                    class="hide-on-mobile"
                    style="background-color: {{ referenced_metaobject.topseal_hex | strip }}"
                  />
                  {% if referenced_metaobject.topseal_in_stock %}
                    <td class="colour-matcher-tick">&#10004;</td>
                  {% else %}
                    <td />
                  {% endif %}
                {% endif %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      $('#colour-matcher-table').DataTable();
    });
  </script>
{% endpaginate %}

{% schema %}
{
  "name": "t:sections.metaobject-datatable.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "textarea",
      "id": "orderable_handles",
      "label": "Orderable product handles",
      "info": "Comma-separated. The Add button matches a row's ColorFill code against the code segment of each variant SKU (e.g. 71101338-CF402 -> CF402). Update this when ColorFill products are added or removed.",
      "default": "colorfill-box,colorfill-tube-black,colorfill-tube-black-aurora,colorfill-tube-brown,colorfill-tube-coffee-cream,colorfill-tube-cool-palette,colorfill-tube-doeskin,colorfill-tube-glacier-nimbus,colorfill-tube-grey-dust,colorfill-tube-grey-glint,colorfill-tube-grey-oak,colorfill-tube-grey-slate-effect,colorfill-tube-grey-vellum,colorfill-tube-grey-vellum-copy,colorfill-tube-linear-oak-effect,colorfill-tube-oak-woodmix,colorfill-tube-polar-white,colorfill-tube-riverwash-monserat,colorfill-tube-sarsen-grey,colorfill-tube-soft-white,colorfill-tube-tavira,colorfill-tube-white-granite-gloss,colorfill-tube-white-grey-marble-copy"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Metaobject Datatable"
    }
  ]
}
{% endschema %}
