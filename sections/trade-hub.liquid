{{ 'trade.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="trade color-{{ section.settings.color_scheme }} gradient">
  {%- if customer.b2b? -%}
    {%- render 'colorfill-swatch-band', limit: 60 -%}

    <div class="page-width section-{{ section.id }}-padding">
      <div class="trade-desk">
        <div class="trade-desk__head">
          <div>
            <h1 class="trade-desk__title">{{ customer.current_company.name }}</h1>
            <p class="trade-desk__meta">
              {%- if customer.current_location.name != blank
                and customer.current_location.name != customer.current_company.name
              -%}
                {{ customer.current_location.name }} ·
              {%- endif -%}
              Account pricing applied at checkout
            </p>
          </div>
          <div class="trade-desk__actions">
            <a class="button" href="{{ section.settings.matcher_url }}">{{ section.settings.matcher_label }}</a>
            <a class="button button--secondary" href="{{ section.settings.shop_url }}">
              {{- section.settings.shop_label -}}
            </a>
          </div>
        </div>

        {%- assign unpaid_count = 0 -%}
        {%- for order in customer.orders limit: 20 -%}
          {%- unless order.financial_status == 'paid' or order.financial_status == 'refunded' -%}
            {%- assign unpaid_count = unpaid_count | plus: 1 -%}
          {%- endunless -%}
        {%- endfor -%}

        {%- if unpaid_count > 0 -%}
          <p class="trade-desk__flag">
            <strong>{{ unpaid_count }}</strong>
            {% if unpaid_count == 1 %}order awaits{% else %}orders await{% endif %} payment.
            <a href="{{ routes.account_url }}">View and pay</a>
          </p>
        {%- endif -%}

        {%- if customer.orders.size > 0 -%}
          <div class="trade-desk__orders">
            <div class="trade-desk__orders-head">
              <h2 class="trade-desk__subtitle">Recent orders</h2>
              <a href="{{ routes.account_url }}">{{ section.settings.orders_label }}</a>
            </div>

            <table class="trade-orders">
              <thead>
                <tr>
                  <th scope="col">Order</th>
                  <th scope="col">Date</th>
                  <th scope="col">Payment</th>
                  <th scope="col" class="trade-orders__hide-mobile">Delivery</th>
                  <th scope="col" class="trade-orders__right">Total</th>
                </tr>
              </thead>
              <tbody>
                {%- for order in customer.orders limit: 5 -%}
                  <tr>
                    <td data-label="Order">
                      <a href="{{ order.customer_url }}">{{ order.name }}</a>
                    </td>
                    <td data-label="Date">{{ order.created_at | date: '%-d %b %Y' }}</td>
                    <td data-label="Payment">
                      {%- if order.financial_status == 'paid' -%}
                        {{ order.financial_status_label }}
                      {%- else -%}
                        <span class="trade-orders__due">{{ order.financial_status_label }}</span>
                      {%- endif -%}
                    </td>
                    <td data-label="Delivery" class="trade-orders__hide-mobile">
                      {{ order.fulfillment_status_label }}
                    </td>
                    <td data-label="Total" class="trade-orders__right">
                      {{ order.total_net_amount | money_with_currency }}
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- else -%}
          <p class="trade-desk__empty">
            No orders yet. Match a laminate to find the codes you need, or browse the range.
          </p>
        {%- endif -%}
      </div>
    </div>

  {%- else -%}
    {%- render 'colorfill-swatch-band', limit: 60 -%}

    <div class="page-width section-{{ section.id }}-padding">
      <div class="trade-lede">
        <h1 class="trade-lede__title">{{ section.settings.heading }}</h1>

        <div class="trade-lede__side">
          {%- if section.settings.intro != blank -%}
            <div class="trade-lede__intro rte">{{ section.settings.intro }}</div>
          {%- endif -%}
          <div class="trade-actions">
            <a class="button" href="{{ section.settings.apply_url }}">{{ section.settings.apply_label }}</a>
            <a class="trade-actions__quiet" href="{{ routes.account_login_url }}">
              {{ section.settings.login_label }}
            </a>
          </div>
        </div>
      </div>

      {%- assign laminate_count = shop.metaobjects.laminates.values_count -%}
      {%- if laminate_count > 0 -%}
        <p class="trade-facts">
          {{ laminate_count }} laminate sheets matched to a ColorFill and TopSeal code, updated as ranges change.
        </p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <dl class="trade-spec">
          {%- for block in section.blocks -%}
            <div class="trade-spec__row" {{ block.shopify_attributes }}>
              <dt class="trade-spec__term">{{ block.settings.title }}</dt>
              <dd class="trade-spec__detail rte">{{ block.settings.text }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Trade hub",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Signed-out / retail" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trade accounts for benchtop fabricators" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "apply_label", "label": "Apply button", "default": "Apply for an account" },
    { "type": "url", "id": "apply_url", "label": "Apply link" },
    { "type": "text", "id": "login_label", "label": "Log in link", "default": "Already have an account? Log in" },
    { "type": "header", "content": "Signed-in trade customer" },
    { "type": "text", "id": "signed_in_heading", "label": "Heading", "default": "Welcome back" },
    { "type": "richtext", "id": "signed_in_note", "label": "Note" },
    { "type": "text", "id": "orders_label", "label": "Orders link", "default": "Orders and invoices" },
    { "type": "text", "id": "matcher_label", "label": "Matcher button", "default": "Match a laminate" },
    { "type": "url", "id": "matcher_url", "label": "Matcher link" },
    { "type": "text", "id": "shop_label", "label": "Shop button", "default": "Shop the range" },
    { "type": "url", "id": "shop_url", "label": "Shop link" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Trade pricing" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Trade hub" }]
}
{% endschema %}
