{{ 'trade.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="trade color-{{ section.settings.color_scheme }} gradient">
  {%- render 'colorfill-swatch-band', limit: 60, url: section.settings.matcher_url -%}

  {%- if customer.b2b? -%}
    <div class="page-width section-{{ section.id }}-padding">
      <div class="trade-desk">
        <div class="trade-desk__head">
          <div>
            <h1 class="trade-desk__title">{{ customer.current_company.name }}</h1>
            <p class="trade-desk__meta">
              {%- if customer.current_location.name != blank
                and customer.current_location.name != customer.current_company.name
              -%}
                {{ customer.current_location.name }} ·
              {%- endif -%}
              Account pricing applied at checkout
            </p>
          </div>
          <div class="trade-desk__actions">
            <a class="button" href="{{ section.settings.pad_url }}">{{ section.settings.pad_label }}</a>
            <a class="button button--secondary" href="{{ section.settings.matcher_url }}">
              {{- section.settings.matcher_label -}}
            </a>
            <a class="trade-actions__quiet" href="{{ section.settings.shop_url }}">
              {{- section.settings.shop_label -}}
            </a>
          </div>
        </div>

        {%- paginate customer.orders by 50 -%}
          {%- liquid
            assign unpaid_count = 0
            assign first_unpaid = null
            for order in customer.orders
              unless order.financial_status == 'paid' or order.financial_status == 'refunded'
                assign unpaid_count = unpaid_count | plus: 1
                if first_unpaid == null
                  assign first_unpaid = order
                endif
              endunless
            endfor
          -%}

          {%- if unpaid_count > 0 -%}
            {%- comment -%}
              Only the first page of orders is in scope here, so an exact count is
              claimed only when there is nothing beyond it to miscount.
            {%- endcomment -%}
            <p class="trade-desk__flag">
              {%- if paginate.pages > 1 -%}
                You have orders awaiting payment.
              {%- elsif unpaid_count == 1 -%}
                <strong>{{ first_unpaid.name }}</strong> is awaiting payment.
              {%- else -%}
                <strong>{{ unpaid_count }}</strong> orders are awaiting payment.
              {%- endif -%}
              {%- if unpaid_count == 1 and paginate.pages == 1 -%}
                <a href="{{ first_unpaid.customer_url }}">View and pay</a>
              {%- else -%}
                <a href="{{ routes.account_url }}">View and pay</a>
              {%- endif -%}
            </p>
          {%- endif -%}

          {%- if customer.orders.size > 0 -%}
            {%- assign last_order = customer.orders.first -%}

            <p class="trade-desk__again">
              Buying the same again?
              <a href="{{ last_order.customer_url }}">
                {{- section.settings.reorder_label }}
                {{ last_order.name -}}
              </a>
            </p>

            <div class="trade-desk__orders">
              <div class="trade-desk__orders-head">
                <h2 class="trade-desk__subtitle">Recent orders</h2>
                <a href="{{ routes.account_url }}">{{ section.settings.orders_label }}</a>
              </div>

              <table role="table" class="trade-orders">
                <caption class="visually-hidden">
                  Your five most recent orders
                </caption>
                <thead role="rowgroup">
                  <tr role="row">
                    <th id="TradeColOrder" scope="col" role="columnheader">Order</th>
                    <th id="TradeColDate" scope="col" role="columnheader">Date</th>
                    <th id="TradeColPayment" scope="col" role="columnheader">Payment</th>
                    <th
                      id="TradeColDelivery"
                      scope="col"
                      role="columnheader"
                      class="trade-orders__hide-mobile"
                    >
                      Delivery
                    </th>
                    <th id="TradeColTotal" scope="col" role="columnheader" class="trade-orders__right">Total</th>
                  </tr>
                </thead>
                <tbody role="rowgroup">
                  {%- for order in customer.orders limit: 5 -%}
                    <tr role="row">
                      <td id="TradeRow{{ order.id }}" role="cell" headers="TradeColOrder" data-label="Order">
                        <a href="{{ order.customer_url }}" aria-label="Order {{ order.name }}">{{ order.name }}</a>
                      </td>
                      <td role="cell" headers="TradeRow{{ order.id }} TradeColDate" data-label="Date">
                        {{ order.created_at | time_tag: format: 'date' }}
                      </td>
                      <td role="cell" headers="TradeRow{{ order.id }} TradeColPayment" data-label="Payment">
                        {%- if order.financial_status == 'paid' -%}
                          {{ order.financial_status_label }}
                        {%- else -%}
                          <span class="trade-orders__due">{{ order.financial_status_label }}</span>
                        {%- endif -%}
                      </td>
                      <td
                        role="cell"
                        headers="TradeRow{{ order.id }} TradeColDelivery"
                        data-label="Delivery"
                        class="trade-orders__hide-mobile"
                      >
                        {{ order.fulfillment_status_label }}
                      </td>
                      <td
                        role="cell"
                        headers="TradeRow{{ order.id }} TradeColTotal"
                        data-label="Total"
                        class="trade-orders__right"
                      >
                        {{ order.total_net_amount | money_with_currency }}
                      </td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          {%- else -%}
            <p class="trade-desk__empty">
              Nothing ordered yet. The order pad lists everything on your account with a box for each, so a whole
              restock goes in at once.
            </p>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>

  {%- else -%}
    <div class="page-width section-{{ section.id }}-padding">
      <div class="trade-lede">
        <h1 class="trade-lede__title">{{ section.settings.heading }}</h1>

        <div class="trade-lede__side">
          {%- if section.settings.intro != blank -%}
            <div class="trade-lede__intro rte">{{ section.settings.intro }}</div>
          {%- endif -%}
          <div class="trade-actions">
            <a class="button" href="{{ section.settings.apply_url }}">{{ section.settings.apply_label }}</a>
            <a class="trade-actions__quiet" href="{{ routes.account_login_url }}">
              {{ section.settings.login_label }}
            </a>
          </div>
        </div>
      </div>

      {%- assign laminate_count = shop.metaobjects.laminates.values_count -%}
      {%- if laminate_count > 0 -%}
        <p class="trade-facts">
          {{ laminate_count }} laminate sheets matched to a ColorFill and TopSeal code, updated as ranges change.
        </p>
      {%- endif -%}

      {%- comment -%}
        The four numbers a fabricator decides on. Blank ones render nothing, so an
        unanswered term is absent rather than wrong.
      {%- endcomment -%}
      {%- assign term_blocks = section.blocks | where: 'type', 'term' -%}
      {%- if term_blocks.size > 0 -%}
        <dl class="trade-terms">
          {%- for block in term_blocks -%}
            {%- if block.settings.value != blank -%}
              <div class="trade-terms__item" {{ block.shopify_attributes }}>
                <dt class="trade-terms__label">{{ block.settings.label }}</dt>
                <dd class="trade-terms__value">{{ block.settings.value }}</dd>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </dl>
      {%- endif -%}

      {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
      {%- if benefit_blocks.size > 0 -%}
        <dl class="trade-spec">
          {%- for block in benefit_blocks -%}
            <div class="trade-spec__row" {{ block.shopify_attributes }}>
              <dt class="trade-spec__term">{{ block.settings.title }}</dt>
              <dd class="trade-spec__detail rte">{{ block.settings.text }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Trade hub",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Signed-out / retail" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trade accounts for benchtop fabricators" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "apply_label", "label": "Apply button", "default": "Apply for an account" },
    { "type": "url", "id": "apply_url", "label": "Apply link" },
    { "type": "text", "id": "login_label", "label": "Log in link", "default": "Already have an account? Log in" },
    { "type": "header", "content": "Signed-in trade customer" },
    {
      "type": "text",
      "id": "pad_label",
      "label": "Order pad button",
      "default": "Order pad",
      "info": "The first thing a returning buyer needs. Keep it first."
    },
    { "type": "url", "id": "pad_url", "label": "Order pad link" },
    {
      "type": "text",
      "id": "reorder_label",
      "label": "Reorder link",
      "default": "Open",
      "info": "The order number is appended, e.g. \"Open #1042\"."
    },
    { "type": "text", "id": "orders_label", "label": "Orders link", "default": "Orders and invoices" },
    { "type": "header", "content": "Shared" },
    { "type": "text", "id": "matcher_label", "label": "Matcher button", "default": "Match a laminate" },
    {
      "type": "url",
      "id": "matcher_url",
      "label": "Matcher link",
      "info": "The colour band at the top of the page links here."
    },
    { "type": "text", "id": "shop_label", "label": "Shop link", "default": "Shop the range" },
    { "type": "url", "id": "shop_url", "label": "Shop link URL" },
    { "type": "header", "content": "Appearance" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "term",
      "name": "Trading term",
      "settings": [
        { "type": "text", "id": "label", "label": "Term", "default": "Payment terms" },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "info": "Leave empty to hide this term until you have an answer."
        }
      ]
    },
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Trade pricing" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Trade hub" }]
}
{% endschema %}
