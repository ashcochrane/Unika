{% comment %}
  Trade context bar.

  Signals to a signed-in B2B buyer which company and location they are
  purchasing for — that choice drives catalog pricing and the delivery
  address, so it must be visible and switchable on every page.

  Renders nothing at all for retail customers.

  Usage, once, directly beneath the header:
  {% render 'company-location-picker' %}
{% endcomment %}

{%- if customer.b2b? -%}
  {{ 'trade.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign company_name = customer.current_company.name | strip
    assign location_name = customer.current_location.name | strip
    assign multi_location = false
    if customer.company_available_locations.size > 1
      assign multi_location = true
    endif
  -%}

  <div class="trade-bar">
    <div class="page-width trade-bar__inner">
      <p class="trade-bar__account">
        <span class="trade-bar__label">Trade account</span>
        <span class="trade-bar__company">{{ company_name }}</span>

        {%- if multi_location -%}
          <details class="trade-bar__switch">
            <summary class="trade-bar__summary">{{ location_name }}</summary>
            <ul class="trade-bar__list" role="list">
              {%- for location in customer.company_available_locations -%}
                {%- unless location.current? -%}
                  <li>
                    <a class="trade-bar__link" href="{{ location.url_to_set_as_current }}">
                      {{ location.name }}
                    </a>
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          </details>
        {%- elsif location_name != blank and location_name != company_name -%}
          <span class="trade-bar__location">{{ location_name }}</span>
        {%- endif -%}
      </p>

      <p class="trade-bar__links">
        <a href="/pages/trade">Trade home</a>
        <a href="{{ routes.account_url }}">Orders &amp; invoices</a>
      </p>
    </div>
  </div>
{%- endif -%}
