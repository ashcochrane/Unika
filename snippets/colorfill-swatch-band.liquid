{% comment %}
  A band of real ColorFill colours, read from the laminate metaobjects that
  power the Colour Matcher. Not decoration — these are the actual compounds
  stocked, so the band is an honest index of the range.

  Given a url it becomes the door into the Colour Matcher, which is what a
  fabricator wants from a wall of colour.

  Accepts:
  - limit: {Number} how many swatches to render (default 60)
  - url: {String} where the band links to (optional)
  - label: {String} accessible name (default "ColorFill colour range")

  Usage:
  {% render 'colorfill-swatch-band', limit: 60, url: '/pages/colour-matcher' %}
{% endcomment %}

{%- liquid
  assign max = limit | default: 60
  assign band_label = label | default: 'ColorFill colour range'
  assign seen = ''
  assign rendered = 0
-%}

{%- capture band_chips -%}
  {%- for laminate in shop.metaobjects.laminates.values limit: 250 -%}
    {%- if rendered >= max -%}{%- break -%}{%- endif -%}
    {%- assign match = laminate.reference.value -%}
    {%- assign hex = match.colorfill_hex | strip -%}
    {%- if hex != blank -%}
      {%- assign key = '|' | append: hex | append: '|' -%}
      {%- unless seen contains key -%}
        {%- assign seen = seen | append: key -%}
        {%- assign rendered = rendered | plus: 1 -%}
        <span class="swatch-band__chip" style="--chip: {{ hex }}"></span>
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if url != blank -%}
  <a class="swatch-band swatch-band--link" href="{{ url }}" aria-label="{{ band_label }}. See every colour match.">
    {{- band_chips -}}
  </a>
{%- else -%}
  <div class="swatch-band" role="img" aria-label="{{ band_label }}">
    {{- band_chips -}}
  </div>
{%- endif -%}
